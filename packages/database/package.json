{
  "name": "@repo/database",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma database schema and client for Al-Huda Portal",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "bun --env-file=../../.env --bun prisma generate",
    "db:migrate": "bun --env-file=../../.env --bun prisma migrate dev",
    "db:migrate:deploy": "bun --env-file=../../.env --bun prisma migrate deploy",
    "db:push": "bun --env-file=../../.env --bun prisma db push",
    "db:seed": "bun run db:generate && bun --env-file=../../.env prisma/seed.ts",
    "db:studio": "bun --env-file=../../.env --bun prisma studio",
    "db:format": "prisma format",
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist node_modules/.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0"
  },
  "devDependencies": {
    "prisma": "^5.19.0",
    "typescript": "^5.3.3",
    "@types/node": "^20.14.0",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6"
  },
  "prisma": {
    "seed": "bun --env-file=../../.env prisma/seed.ts"
  }
}

